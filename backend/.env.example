DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/setup_leitos
SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
SESSION_MAX_AGE_DAYS=30

# development, test ou production
ENVIRONMENT=development

# Deve ser true quando o sistema estiver publicado com HTTPS.
COOKIE_SECURE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Usadas somente quando o seed precisa criar as contas iniciais.
# Remova estas variáveis do ambiente depois do primeiro seed.
SEED_COORDINATOR_PASSWORD=defina-uma-senha-forte
SEED_ADMIN_PASSWORD=defina-outra-senha-forte

# Ative somente em um banco descartável de homologação.
ALLOW_HOMOLOGATION_DATA=false
